{
  "$schema": "https://biomejs.dev/schemas/2.3.6/schema.json",
  "files": {
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/build",
      "!!**/.vscode",
      "!!**/.tamagui",
      "!!**/ios",
      "!!**/android",
      "!!**/*.test.ts",
      "!!**/*.test.tsx",
      "!!**/*.css",
      "!!**/packages/fonts/types/index.d.ts",
      "!!**/coverage",
      "!!**/.turbo"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "assist": {
    "actions": {
      "source": {
        "useSortedKeys": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "es5",
      "semicolons": "asNeeded",
      "bracketSameLine": false
    }
  },
  "json": {
    "parser": {
      "allowComments": true,
      "allowTrailingCommas": true
    },
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "error",
        "useExhaustiveDependencies": "off"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noRedeclare": "off"
      },
      "style": {
        "useImportType": "warn",
        "useNodejsImportProtocol": "off",
        "noNonNullAssertion": "warn",
        "noUnusedTemplateLiteral": "off"
      },
      "complexity": {
        "useLiteralKeys": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/packages/core/features/profile/profile-skills-left.tsx",
        "**/packages/supabase/functions/_shared/client-types.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/packages/supabase/functions/**/*.ts",
        "**/packages/supabase/functions/**/*.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "useImportType": "off",
            "useNodejsImportProtocol": "off"
          },
          "correctness": {
            "noUndeclaredVariables": "off"
          }
        }
      }
    }
  ]
}
