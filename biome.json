{
  "$schema": "https://biomejs.dev/schemas/2.3.6/schema.json",
  "assist": {
    "actions": {
      "source": {
        "useSortedKeys": "off",
        "organizeImports": "off"
      }
    }
  },
  "files": {
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/build",
      "!!**/dist",
      "!!**/.vscode",
      "!!**/ios",
      "!!**/android",
      "!!**/*.test.ts",
      "!!**/*.test.tsx",
      "!!**/*.css",
      "!!**/packages/fonts/types/index.d.ts",
      "!!**/tests/reports/coverage",
      "!!**/.turbo",
      "!!**/.nx",
      "!!**/.storybook",
      "!!**/packages/supabase/scripts/seed-universities.json",
      "!!**/packages/supabase/email-templates/**",
      "!!packages/insurance/**",
      "!!packages/compliance/**",
      "!!packages/tasks/**",
      "!!**/storybook-static",
      "!!**/docs-site/.docusaurus"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "bracketSameLine": false,
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "es5"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    },
    "parser": {
      "allowComments": true,
      "allowTrailingCommas": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "complexity": {
        "useLiteralKeys": "off"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "useExhaustiveDependencies": "warn"
      },
      "recommended": true,
      "security": {
        "noDangerouslySetInnerHtml": "off"
      },
      "style": {
        "noNonNullAssertion": "warn",
        "noUnusedTemplateLiteral": "warn",
        "useImportType": "error",
        "useNodejsImportProtocol": "off"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noRedeclare": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/packages/supabase/functions/**/*.ts",
        "**/packages/supabase/functions/**/*.tsx"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredVariables": "off"
          },
          "style": {
            "useImportType": "off",
            "useNodejsImportProtocol": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/.storybook/**/*.ts",
        "**/.storybook/**/*.tsx"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedFunctionParameters": "off"
          },
          "style": {
            "useImportType": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/beyond-ui/src/**/*.ts",
        "packages/beyond-ui/src/**/*.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "warn"
          },
          "correctness": {
            "noUnusedFunctionParameters": "warn",
            "noUnusedVariables": "warn",
            "noInvalidUseBeforeDeclaration": "warn",
            "useHookAtTopLevel": "warn"
          },
          "suspicious": {
            "noExplicitAny": "warn",
            "noArrayIndexKey": "warn",
            "useIterableCallbackReturn": "warn"
          }
        }
      }
    },
    {
      "includes": [
        "packages/scaffald-cli/src/**/*.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "warn"
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/**/*.ts",
        "apps/web/**/*.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "warn",
            "useButtonType": "warn",
            "noLabelWithoutControl": "warn",
            "useSemanticElements": "warn"
          },
          "style": {
            "useImportType": "warn"
          }
        }
      }
    },
    {
      "includes": [
        "packages/ui/src/**/*.ts",
        "packages/ui/src/**/*.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "useImportType": "warn"
          },
          "suspicious": {
            "noExplicitAny": "warn",
            "noArrayIndexKey": "off"
          },
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedFunctionParameters": "off",
            "useHookAtTopLevel": "warn"
          }
        }
      }
    }
  ]
}
