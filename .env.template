###
# PUBLIC VARS
###

# @see https://docs.expo.dev/guides/environment-variables/
EXPO_PUBLIC_URL=https://app.scaffald.com
# Local: use http://127.0.0.1:54321 (REST API requires pnpm supa:functions in a second terminal)
EXPO_PUBLIC_SUPABASE_URL=https://<id>.supabase.co
# DO NOT SET EXPO_PUBLIC_SCAFFALD_API_URL. jobs-sdk-context.tsx derives the API
# base as ${EXPO_PUBLIC_SUPABASE_URL}/functions/v1/api, which is correct for both
# local and remote envs. If you define it here, Expo loads .env before
# .env.production at build time and the localhost value SURVIVES into the prod
# bundle (.env.production doesn't override what it doesn't define) — that's how
# the 2026-06 magic-link prod outage happened.
EXPO_PUBLIC_SUPABASE_REDIRECT_URI=https://<id>.supabase.co/auth/v1/callback
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Mapbox Production Configuration
EXPO_PUBLIC_MAPBOX_API_URL=https://api.mapbox.com
EXPO_PUBLIC_MAPBOX_TOKEN=pk.eyJ1I...

