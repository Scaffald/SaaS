# Linear API key — only needed in .env.production. Used by
# `pnpm release:promote X.Y.Z` (scripts/release-promote-linear.mjs) to move
# vX.Y.Z-labeled Linear issues from "In Github" → "In TestFlight" after
# a TestFlight build goes live. Personal key from
# https://linear.app/settings/account/security.
LINEAR_API_KEY=lin_api_...

# Resend — the single transport for all outbound email: notification emails
# from the Supabase edge functions and the marketing contact form. Create a
# key at https://resend.com/api-keys. "Sending access" is enough to send;
# scripts/setup-resend.ts needs "Full access" because it manages domains.
#
# This same key has to be set in three places, which are separate runtimes and
# do NOT share secrets:
#   1. here, for local dev
#   2. Supabase edge function secrets  (notification email)
#   3. EAS Hosting environment         (the /api/contact route)
RESEND_API_KEY=re_...

# Optional overrides. Must be on a Resend-verified domain — scaffald.com is
# verified, so anything @scaffald.com works.
# RESEND_FROM_EMAIL=notifications@scaffald.com
# RESEND_FROM_NAME=Scaffald
# CONTACT_FORM_TO=hello@scaffald.com
