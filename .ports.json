{
  "description": "SCF-Scaffald monorepo (Expo app + local Supabase)",
  "ports": {
    "expo-dev-server": {
      "description": "Expo development server",
      "environment": "development",
      "port": 8081,
      "protocol": "http",
      "required": true
    },
    "mailpit": {
      "description": "Mailpit (local email)",
      "environment": "development",
      "port": 54324,
      "protocol": "http",
      "required": false
    },
    "supabase": {
      "description": "Supabase local stack",
      "environment": "development",
      "port": 54321,
      "protocol": "http",
      "required": true
    },
    "supabase-studio": {
      "description": "Supabase Studio",
      "environment": "development",
      "port": 54323,
      "protocol": "http",
      "required": false
    },
    "web-dev": {
      "description": "Web development server (when using pnpm web)",
      "environment": "development",
      "port": 3000,
      "protocol": "http",
      "required": false
    }
  },
  "project": "SCF-Scaffald"
}
