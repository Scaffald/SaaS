{
  "lock": false,
  "nodeModulesDir": "auto",
  "importMap": "./import_map.json",
  "compilerOptions": {
    "lib": ["esnext", "deno.window", "deno.ns"],
    "strict": false,
    "noImplicitAny": false
  },
  "lint": {
    "rules": {
      "exclude": ["no-explicit-any"]
    }
  },
  "exclude": [
    "node_modules",
    "_types/stripe.d.ts",
    "_shared/deno-ambient.d.ts",
    "**/*.test.ts",
    "**/__tests__/**"
  ]
}
