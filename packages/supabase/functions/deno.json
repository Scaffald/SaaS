{
  "lock": false,
  "nodeModulesDir": "auto",
  "importMap": "./import_map.json",
  "compilerOptions": {
    "allowJs": true,
    "lib": ["esnext", "deno.window", "deno.ns"],
    "strict": false,
    "noImplicitAny": false
  },
  "lint": {
    "rules": {
      "exclude": ["no-explicit-any"]
    }
  },
  "exclude": ["node_modules"]
}
