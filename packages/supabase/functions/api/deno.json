{
  "lock": false,
  "//nodeModulesDir": "Required so `deno lint`/`deno fmt` resolve the npm: imports below without a pre-existing node_modules. The Lint REST API Code job runs from this dir and does NOT run pnpm install, so without this deno aborts at startup with 'Linking npm packages requires ... nodeModulesDir' (#399).",
  "nodeModulesDir": "auto",
  "imports": {
    "hono": "npm:hono@^4.0.0",
    "hono/": "npm:hono@^4.0.0/",
    "@hono/zod-openapi": "npm:@hono/zod-openapi@0.18.2",
    "@supabase/supabase-js": "https://esm.sh/@supabase/supabase-js@2.39.0",
    "zod": "https://deno.land/x/zod@v3.22.4/mod.ts",
    "@hono/zod-validator": "npm:@hono/zod-validator@0.4.2",
    "@scf/supabase/types": "../../types.ts",
    "mammoth": "npm:mammoth@1.6.0",
    "pdf-lib": "npm:pdf-lib@1.17.1"
  },
  "tasks": {
    "dev": "deno run --allow-all --watch index.ts",
    "test": "deno test --allow-all"
  },
  "lint": {
    "rules": {
      "exclude": [
        "require-await",
        "no-explicit-any",
        "no-unused-vars",
        "no-import-prefix",
        "no-unversioned-import"
      ]
    }
  },
  "compilerOptions": {
    "lib": [
      "deno.window",
      "deno.unstable"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "https://esm.sh/react@18.2.0"
  }
}
