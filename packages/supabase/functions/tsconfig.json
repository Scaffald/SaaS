{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": false,
    "lib": ["esnext", "deno.ns"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "types": ["npm:@types/deno"],
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowJs": true,
    "noImplicitAny": false
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
