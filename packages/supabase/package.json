    "posthog-node": "^5.48.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "pg": "^8.22.0",
    "stripe": "20.4.1",
    "supabase": "catalog:",
    "typescript": "catalog:",
    "uuid": "^14.0.1"
  }
