-- =========================================================
-- Users Seed
-- UUIDs are dynamically generated by PostgreSQL
-- Uses email as the stable key to link records across tables
-- Super Admins: unicorn.love and circleave.com domains
-- =========================================================

-- =========================================================
-- TRANSACTION 1: Disable trigger and insert auth.users
-- =========================================================
BEGIN;

DROP TRIGGER IF EXISTS on_auth_user_created ON auth.users;

INSERT INTO auth.users (
  instance_id,
  email,
  encrypted_password,
  email_confirmed_at,
  last_sign_in_at,
  raw_app_meta_data,
  raw_user_meta_data,
  aud,
  role,
  created_at,
  updated_at,
  is_super_admin,
  confirmation_token,
  recovery_token,
  email_change_token_new,
  email_change,
  phone_change,
  phone_change_token,
  email_change_token_current,
  reauthentication_token
) 
SELECT 
  gen_random_uuid(),
  users.email::text,
  crypt('password123', gen_salt('bf')),
  NOW() - (random() * INTERVAL '90 days'),
  NOW() - (random() * INTERVAL '30 days'),
  '{"provider": "email", "providers": ["email"]}'::jsonb,
  jsonb_build_object(
    'provider', 'email',
    'name', users.name,
    'first_name', users.first_name,
    'last_name', users.last_name,
    'phone', users.phone,
    'location', users.location
  ),
  'authenticated',
  'authenticated',
  NOW() - (random() * INTERVAL '90 days'),
  NOW() - (random() * INTERVAL '30 days'),
  users.is_super_admin,
  '',
  '',
  '',
  '',
  '',
  '',
  '',
  ''
