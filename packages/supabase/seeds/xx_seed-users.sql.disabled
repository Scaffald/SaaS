-- =========================================================
-- TRANSACTION 3: Insert into private.profile
-- =========================================================
BEGIN;

INSERT INTO private.profile (
  user_id,
  phone,
  first_name,
  last_name,
  location,
  created_at,
  updated_at
)
SELECT 
  au.id,
  (au.raw_user_meta_data->>'phone')::text,
  (au.raw_user_meta_data->>'first_name')::text,
  (au.raw_user_meta_data->>'last_name')::text,
  (au.raw_user_meta_data->>'location')::text,
  au.created_at,
  au.updated_at
FROM auth.users au
WHERE au.email IN (
