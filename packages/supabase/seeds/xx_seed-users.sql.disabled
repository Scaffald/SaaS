  'clay@scaffald.com', 'rdoucette@cpsd.us', 'cbenroll@ssvotech.org',
  'davidcasinghino@gmail.com', 'shorgan0011@gmail.com', 'jordanelster10@gmail.com',
  'miqueiasaneves@eths.education', 'colinclong03@gmail.com', 'jacksoncefalo@gmail.com', 'dterry86@gmail.com',
  'stefano.sestito@yahoo.com', 'russell@andoverlandscape.com', 'eavan@lighthouseconstruction.com', 'jjwyz71@icloud.com',
  'joseph.attia@quantalytixgroup.com', 'ogbewesy@gmail.com', 'abdulfawad.azizi@gmail.com', 'aaronpdasilva0@gmail.com',
  'jwgiering@rocketmail.com', 'steve@lighthouseconstruction.com', 'aidananaloro2008@gmail.com',
  'jordanminaya30@gmail.com', 'oliviadodge08@gmail.com', 'braydend.086@gmail.com', 'achiarenza329@gmail.com',
  'kacyyyyy278@gmail.com', 'rileym2206@icloud.com', 'lucaspezzulo@yahoo.com', 'rmae7859@gmail.com',
  'kayla.perez@eths.education', 'maxxsimon2008@gmail.com', 'miqueiasaneves@icloud.com', 'jack.doucette10@gmail.com',
