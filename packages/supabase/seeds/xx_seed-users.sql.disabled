-- =========================================================
-- TRANSACTION 2: Insert into public.users
-- =========================================================
BEGIN;

INSERT INTO public.users (
  id,
  username,
  slug,
  display_name,
  headline,
  bio,
  industry_id,
  open_to_work,
  years_of_experience,
  skills_summary,
  created_at,
  updated_at
)
SELECT 
  au.id,
  lower(regexp_replace(split_part(au.email, '@', 1), '[^a-zA-Z0-9]', '-', 'g')) || '-' || substring(au.id::text from 1 for 8),
  lower(regexp_replace(split_part(au.email, '@', 1), '[^a-zA-Z0-9]', '-', 'g')) || '-' || substring(au.id::text from 1 for 8),
  (au.raw_user_meta_data->>'name')::text,
  'Construction Professional | 0 Years',
  '',
  (SELECT id FROM public.industries WHERE slug = 'construction'),
  true,
  0,
  '{"skills":[],"primary_location":{},"travel_radius_miles":0}'::jsonb,
  au.created_at,
  au.updated_at
FROM auth.users au
WHERE au.email IN (
  'zach@unicorn.love', 'clay@unicorn.love', 'marc@unicorn.love',
  'eric@circleave.com', 'jaylen@circleave.com', 'christian@circleave.com', 'matthew@circleave.com', 'dillon@circleave.com',
