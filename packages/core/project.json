{
  "name": "core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/core",
  "projectType": "library",
  "tags": ["scope:core", "type:feature"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --build",
        "cwd": "packages/core"
      },
      "outputs": ["{projectRoot}/tsconfig.tsbuildinfo"]
    },
    "test": {
      "executor": "@nx/vite:test",
      "options": {
        "config": "packages/core/vitest.config.ts",
        "passWithNoTests": true
      },
      "outputs": ["{workspaceRoot}/coverage/core"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "biome lint .",
        "cwd": "packages/core"
      }
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "biome lint --write .",
        "cwd": "packages/core"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "packages/core"
      }
    },
    "watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --watch",
        "cwd": "packages/core"
      }
    }
  }
}
