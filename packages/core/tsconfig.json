{
  "compilerOptions": {
    "baseUrl": ".",
    "composite": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@app/core": ["."],
      "@app/core/*": ["./*"],
      "@app/supabase": ["../supabase"],
      "@app/supabase/*": ["../supabase/*"],
      "@app/schemas": ["../schemas/src"],
      "@app/schemas/*": ["../schemas/src/*"],
      "@app/trpc": ["../trpc/src"],
      "@app/trpc/*": ["../trpc/src/*"],
      "@unicornlove/ui": ["../ui/src"],
      "@unicornlove/ui/*": ["../ui/src/*"],
      "expo-clipboard": ["../../types/expo-clipboard.d.ts"]
    },
    "plugins": []
  },
  "exclude": [
    "../../supabase/functions/**/*",
    "../../supabase/migrations/**/*",
    "../../supabase/scripts/**/*",
    "../supabase/functions/**/*",
    "../supabase/migrations/**/*",
    "../supabase/scripts/**/*"
  ],
  "extends": "../../tsconfig.base",
  "include": [
    "assets",
    "components",
    "features",
    "forms",
    "hooks",
    "provider",
    "utils",
    "locales",
    "constants",
    "index.ts",
    "types.d.ts",
    "types",
    "package.json",
    "../ui/src",
    "../../types/custom-modules.d.ts"
  ],
  "references": []
}
