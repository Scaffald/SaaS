{
  "extends": "../../tsconfig.base",
  "include": [
    "features",
    "provider",
    "utils",
    "constants",
    "index.ts",
    "types.d.ts",
    "package.json",
    "../../package.json",
    "../ui/src",
    "../api/src",
    "../../supabase/types.ts",
    "../../supabase/helpers.ts"
  ],
  "exclude": [
    "../../supabase/functions/**/*",
    "../../supabase/migrations/**/*",
    "../../supabase/scripts/**/*"
  ],
  "compilerOptions": {
    "noEmit": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@app/core": ["."],
      "@app/core/*": ["./*"],
      "@app/supabase": ["../../supabase"],
      "@app/supabase/*": ["../../supabase/*"]
    },
    "plugins": []
  },
  "references": []
}
