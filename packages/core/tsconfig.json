{
  "extends": "../../tsconfig.base",
  "include": [
    "assets",
    "features",
    "forms",
    "provider",
    "utils",
    "constants",
    "index.ts",
    "types.d.ts",
    "types",
    "package.json",
    "../../package.json",
    "../ui/src",
    "../api/src",
    "../../supabase/types.ts",
    "../../supabase/helpers.ts",
    "../../supabase/functions/_shared/deno-modules.d.ts",
    "../../types/custom-modules.d.ts"
  ],
  "exclude": [
    "../../supabase/functions/**/*",
    "../../supabase/migrations/**/*",
    "../../supabase/scripts/**/*"
  ],
  "compilerOptions": {
    "noEmit": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@app/core": ["."],
      "@app/core/*": ["./*"],
      "@app/supabase": ["../../supabase"],
      "@app/supabase/*": ["../../supabase/*"],
      "expo-clipboard": ["../../types/expo-clipboard.d.ts"]
    },
    "plugins": []
  },
  "references": []
}
