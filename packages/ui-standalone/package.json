{
  "name": "@scaffald/tamagui-ui",
  "version": "1.0.0",
  "description": "Comprehensive UI component library for Tamagui and Expo",
  "keywords": [
    "tamagui",
    "expo",
    "react-native",
    "ui",
    "components"
  ],
  "author": "Scaffald",
  "homepage": "https://github.com/Unicorn/SCF-Neue/tree/main/packages/ui-standalone",
  "bugs": {
    "url": "https://github.com/Unicorn/SCF-Neue/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Unicorn/SCF-Neue",
    "directory": "packages/ui-standalone"
  },
  "license": "MIT",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styleguide": {
      "types": "./dist/styleguide/index.d.ts",
      "import": "./dist/styleguide/index.mjs",
      "require": "./dist/styleguide/index.js"
    },
    "./types/geographic": {
      "types": "./dist/types/geographic.d.ts",
      "import": "./dist/types/geographic.mjs",
      "require": "./dist/types/geographic.js"
    },
    "./types/phone": {
      "types": "./dist/types/phone.d.ts",
      "import": "./dist/types/phone.mjs",
      "require": "./dist/types/phone.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build",
    "check": "tamagui check",
    "check:type": "tsc --noEmit",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "format": "biome format ./src",
    "format:fix": "biome format --write ./src",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.74.0",
    "expo": ">=51.0.0",
    "tamagui": ">=1.138.0",
    "@tamagui/core": ">=1.138.0",
    "react-hook-form": ">=7.0.0",
    "zod": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "catalog:",
    "@tamagui/animations-moti": "catalog:",
    "@tamagui/animations-react-native": "catalog:",
    "@tamagui/font-inter": "catalog:",
    "@tamagui/helpers-icon": "catalog:",
    "@tamagui/lucide-icons": "catalog:",
    "@tamagui/theme-builder": "catalog:",
    "@tamagui/toast": "catalog:",
    "@tanstack/react-table": "catalog:",
    "@tiptap/core": "^2.27.1",
    "@tiptap/extension-placeholder": "^2.27.1",
    "@tiptap/extension-underline": "^2.27.1",
    "@tiptap/react": "^2.27.1",
    "@tiptap/starter-kit": "^2.27.1",
    "@ts-react/form": "catalog:",
    "expo-router": "catalog:",
    "moti": "catalog:",
    "react-dom": "catalog:",
    "react-dropzone": "catalog:",
    "react-native-reanimated": "catalog:",
    "awesome-phonenumber": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "tsup": "^8.0.0",
    "typescript": "catalog:",
    "vitest": "^4.0.10"
  }
}

