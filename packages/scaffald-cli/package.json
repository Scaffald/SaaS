{
  "name": "@scaffald/cli",
  "version": "0.1.0",
  "description": "Command-line interface for Scaffald API",
  "type": "module",
  "bin": {
    "scaffald": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@scaffald/sdk": "workspace:*",
    "commander": "^12.1.0",
    "chalk": "^5.3.0",
    "ora": "^8.1.1",
    "enquirer": "^2.4.1",
    "cli-table3": "^0.6.5",
    "conf": "^13.0.1",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "scaffald",
    "cli",
    "jobs",
    "api",
    "recruitment"
  ],
  "author": "Scaffald",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
