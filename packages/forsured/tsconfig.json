{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "outDir": "./dist",
    "baseUrl": ".",
    "types": ["node", "react", "react-dom"],
    "paths": {
      "@/*": ["./src/*"],
      "@unicornlove/insurance": ["../insurance/src"],
      "@unicornlove/insurance/*": ["../insurance/src/*"],
      "@unicornlove/compliance": ["../compliance/src"],
      "@unicornlove/compliance/*": ["../compliance/src/*"],
      "@unicornlove/tasks": ["../tasks/src"],
      "@unicornlove/tasks/*": ["../tasks/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/**/*.test.tsx", "src/**/__tests__/**/*"]
}
