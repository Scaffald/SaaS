{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["esnext", "deno", "deno.ns"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noImplicitAny": false,
    "paths": {
      "@scf/trpc": ["../../scf-trpc/src"],
      "@scf/trpc/*": ["../../scf-trpc/src/*"],
      "@scf/schemas": ["../../scf-schemas/src"],
      "@scf/schemas/*": ["../../scf-schemas/src/*"]
    },
    "skipLibCheck": true,
    "strict": false,
    "types": ["npm:@types/deno"]
  },
  "exclude": ["node_modules"],
  "extends": "../../../tsconfig.base.json",
  "include": ["**/*.ts", "**/*.tsx", "../../scf-trpc/src/types/**/*.d.ts"]
}
