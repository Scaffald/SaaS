{
  "name": "scf-supabase",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/scf-supabase",
  "projectType": "library",
  "tags": ["scope:backend", "type:data"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --build",
        "cwd": "packages/scf-supabase"
      },
      "outputs": ["{projectRoot}/tsconfig.tsbuildinfo"],
      "dependsOn": []
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "packages/scf-supabase"
      },
      "outputs": ["{workspaceRoot}/tests/reports/coverage/scf-supabase"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "biome lint .",
        "cwd": "packages/scf-supabase"
      }
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "biome lint --write .",
        "cwd": "packages/scf-supabase"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "packages/scf-supabase"
      }
    },
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotenv -e ../../.env -- supabase gen types typescript --local > types.ts",
        "cwd": "packages/scf-supabase"
      },
      "outputs": ["{projectRoot}/types.ts"]
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "supabase start",
        "cwd": "packages/scf-supabase"
      }
    },
    "stop": {
      "executor": "nx:run-commands",
      "options": {
        "command": "supabase stop",
        "cwd": "packages/scf-supabase"
      }
    },
    "functions:serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "supabase functions serve --env-file .env",
        "cwd": "packages/scf-supabase"
      }
    }
  }
}
