{
  "compilerOptions": {
    "baseUrl": ".",
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@scf/core": ["."],
      "@scf/core/*": ["./*"],
      "@scf/supabase": ["../supabase"],
      "@scf/supabase/*": ["../supabase/*"],
      "@scf/schemas": ["../scf-schemas/src"],
      "@scf/schemas/*": ["../scf-schemas/src/*"],
      "@scf/trpc": ["../scf-trpc/src"],
      "@scf/trpc/*": ["../scf-trpc/src/*"],
      "@test-helpers": ["../../tests/infrastructure/vitest/helpers"],
      "@test-helpers/*": ["../../tests/infrastructure/vitest/helpers/*"],
      "@unicornlove/ui": ["../ui/src"],
      "@unicornlove/ui/*": ["../ui/src/*"],
      "expo-clipboard": ["../../types/expo-clipboard.d.ts"]
    },
    "plugins": []
  },
  "exclude": [
    "../../supabase/functions/**/*",
    "../../supabase/migrations/**/*",
    "../../supabase/scripts/**/*",
    "../supabase/functions/**/*",
    "../supabase/migrations/**/*",
    "../supabase/scripts/**/*"
  ],
  "extends": "../../tsconfig.base",
  "include": [
    "assets",
    "components",
    "features",
    "forms",
    "hooks",
    "provider",
    "utils",
    "locales",
    "constants",
    "index.ts",
    "types.d.ts",
    "types",
    "package.json",
    "../ui/src",
    "../../types/custom-modules.d.ts"
  ],
  "references": []
}
