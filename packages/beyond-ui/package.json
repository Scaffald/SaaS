{
  "name": "@unicornlove/beyond-ui",
  "version": "0.1.0",
  "private": false,
  "description": "Custom UI component library - Next generation of @unicornlove/ui. Built with inline styles for React Native and web, designed from the Forsured Design System.",
  "keywords": [
    "react",
    "react-native",
    "ui",
    "components",
    "design-system",
    "beyond-ui"
  ],
  "homepage": "https://github.com/Unicorn/unicornlove-beyond-ui",
  "bugs": {
    "url": "https://github.com/Unicorn/unicornlove-beyond-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Unicorn/unicornlove-beyond-ui"
  },
  "license": "MIT",
  "author": "Scaffald",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.mjs",
      "require": "./dist/tokens/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declaration",
    "check:type": "tsc --noEmit",
    "format": "biome format ./src",
    "format:fix": "biome format --write ./src",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "watch": "tsup --watch"
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "~2.3.6",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.3.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/node": "~20.0.0",
    "@types/react": "~19.2.0",
    "tsup": "^8.5.1",
    "typescript": "catalog:",
    "vitest": "^4.0.15"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.74.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  }
}
