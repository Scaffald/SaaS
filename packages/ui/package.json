{
  "name": "@app/ui",
  "version": "0.0.1",
  "sideEffects": ["*.css"],
  "private": true,
  "types": "./src",
  "main": "src/index.tsx",
  "module:jsx": "src",
  "files": ["types", "dist"],
  "scripts": {
    "build": "tamagui-build --skip-types",
    "watch": "tamagui-build --skip-types --watch",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "format": "biome format ./src",
    "format:fix": "biome format --write ./src",
    "generate-theme": "tamagui generate-themes ./src/themes/theme.ts ./src/themes/theme-generated.ts",
    "check:type": "tsc --outDir /tmp",
    "check:type:watch": "yarn check:type -w",
    "check-circular-deps": "../../scripts/check-circular-deps.sh ./src/index.tsx"
  },
  "dependencies": {
    "@babel/runtime": "^7.18.9",
    "@hookform/resolvers": "^3.1.0",
    "@tamagui/animations-moti": "^1.133.1",
    "@tamagui/animations-react-native": "^1.133.1",
    "@tamagui/cli": "^1.133.1",
    "@tamagui/config": "^1.133.1",
    "@tamagui/create-theme": "^1.133.1",
    "@tamagui/font-inter": "^1.133.1",
    "@tamagui/helpers-icon": "^1.133.1",
    "@tamagui/react-native-media-driver": "^1.133.1",
    "@tamagui/shorthands": "^1.133.1",
    "@tamagui/theme-builder": "^1.133.1",
    "@tamagui/themes": "^1.133.1",
    "@tamagui/toast": "^1.133.1",
    "@ts-react/form": "1.6.4",
    "moti": "^0.25.3",
    "react-hook-form": "^7.63.0",
    "tamagui": "^1.133.1",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tamagui/build": "^1.133.1",
    "typescript": "^5.9.2"
  }
}
