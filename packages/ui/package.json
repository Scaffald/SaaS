{
  "name": "@app/ui",
  "version": "0.0.1",
  "private": true,
  "sideEffects": ["*.css"],
  "types": "./src",
  "main": "src/index.tsx",
  "module:jsx": "src",
  "files": ["src"],
  "exports": {
    ".": "./src/index.tsx",
    "./styleguide": "./src/styleguide/index.ts",
    "./styleguide/*": "./src/styleguide/*"
  },
  "scripts": {
    "check": "tamagui check",
    "check:type": "tsc --outDir /tmp",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "format": "biome format ./src",
    "format:fix": "biome format --write ./src",
    "check-circular-deps": "../../scripts/check-circular-deps.sh ./src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@app/schemas": "workspace:*",
    "@babel/runtime": "catalog:",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "catalog:",
    "@tamagui/animations-moti": "catalog:",
    "@tamagui/animations-react-native": "catalog:",
    "@tamagui/cli": "catalog:",
    "@tamagui/config": "catalog:",
    "@tamagui/core": "catalog:",
    "@tamagui/create-theme": "^1.135.0",
    "@tamagui/font-inter": "catalog:",
    "@tamagui/helpers-icon": "catalog:",
    "@tamagui/lucide-icons": "catalog:",
    "@tamagui/react-native-media-driver": "catalog:",
    "@tamagui/shorthands": "catalog:",
    "@tamagui/theme-builder": "^1.135.0",
    "@tamagui/themes": "catalog:",
    "@tamagui/toast": "catalog:",
    "@tanstack/react-table": "catalog:",
    "@tiptap/core": "^2.27.1",
    "@tiptap/extension-placeholder": "^2.27.1",
    "@tiptap/extension-underline": "^2.27.1",
    "@tiptap/react": "^2.27.1",
    "@tiptap/starter-kit": "^2.27.1",
    "@ts-react/form": "catalog:",
    "expo-router": "catalog:",
    "moti": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-dropzone": "catalog:",
    "react-hook-form": "catalog:",
    "react-native-reanimated": "catalog:",
    "tamagui": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
