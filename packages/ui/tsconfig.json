{
  "extends": "../../tsconfig.base",
  "include": [
    "src",
    "test",
    "../app",
    "../api/src",
    "../../package.json",
    "../../supabase",
    "../../tests/utils/src",
    "vitest.setup.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "../api/src/__tests__",
    "../api/src/**/__tests__/*",
    "../api/src/**/*.test.ts",
    "../api/src/**/*.test.tsx"
  ],
  "compilerOptions": {
    "noEmit": true,
    "composite": true,
    "jsx": "react-jsx",
    "plugins": [],
    "skipLibCheck": true,
    "types": ["vitest", "node", "@testing-library/jest-dom", "@types/jest"],
    "typeRoots": ["../../node_modules/@types", "../../node_modules", "../../environment.d.ts"]
  },
  "references": []
}
