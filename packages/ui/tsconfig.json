{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "declarationMap": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": false,
    "noImplicitAny": false,
    "outDir": "./dist",
    "resolveJsonModule": true,
    "rootDir": "./src",
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": false,
    "target": "ES2020"
  },
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.stories.ts",
    "**/*.stories.tsx",
    ".storybook",
    "src/CardStack.tsx",
    "src/components/cards/CardBadges.tsx",
    "src/components/dialog/Dialog.tsx",
    "src/components/dialog/ConfirmationDialog.tsx",
    "src/components/image-picker/AvatarCropModal.tsx",
    "src/components/inputs/Radio.tsx",
    "src/components/inputs/Checkbox.tsx",
    "src/components/popovers/Popover.tsx",
    "src/components/sheets/Sheet.tsx",
    "src/components/table/TableParts.tsx",
    "src/components/typography/Heading.tsx",
    "src/config/animations.ts",
    "**/*.d.ts"
  ],
  "include": ["src/**/*"]
}
