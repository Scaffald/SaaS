{
  "name": "schemas",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/schemas/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:util"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --build",
        "cwd": "packages/schemas"
      },
      "outputs": ["{projectRoot}/tsconfig.tsbuildinfo"]
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "config": "packages/schemas/vitest.config.ts",
        "passWithNoTests": true
      },
      "outputs": ["{workspaceRoot}/tests/reports/coverage/schemas"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "biome lint .",
        "cwd": "packages/schemas"
      }
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "biome lint --write .",
        "cwd": "packages/schemas"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "packages/schemas"
      }
    }
  }
}
