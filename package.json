{
  "name": "scaffald",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "reset": "rm -rf node_modules apps/*/node_modules packages/*/node_modules .turbo apps/*/.turbo packages/*/.turbo apps/expo/.expo apps/expo/.tamagui apps/expo/dist apps/expo/android/build apps/expo/ios/build apps/expo/.next **/tsconfig.tsbuildinfo **/.DS_Store && pnpm store prune && echo '✅ Cache cleared! Run pnpm install to reinstall dependencies.'",
    "reset:full": "pnpm reset && rm -rf apps/expo/android apps/expo/ios && echo '✅ Full reset complete! Run pnpm prebuild to regenerate native directories.'",
    "watchman:reset": "watchman watch-del \"$(pwd)\" ; watchman watch-project \"$(pwd)\"",
    "env-local": "cross-env NODE_ENV=development APP_ENV=development dotenv -e .env --",
    "env-prod": "cross-env NODE_ENV=production APP_ENV=production dotenv -e .env.production --",
    "env-preview": "cross-env NODE_ENV=production APP_ENV=preview dotenv -e .env.preview --",
    "dev": "(pnpm watchman:reset || true) && pnpm --filter expo-app start",
    "ios": "pnpm --filter expo-app ios",
    "android": "pnpm --filter expo-app android",
    "web": "pnpm --filter expo-app web",
    "web:build": "pnpm --filter expo-app web:build",
    "prebuild": "pnpm --filter expo-app prebuild",
    "prod": "./scripts/deploy.sh production",
    "preview": "./scripts/deploy.sh preview",
    "deploy": "pnpm prod",
    "deploy:reset": "./scripts/deploy-reset.sh",
    "deploy:aws": "./scripts/deploy-aws.sh",
    "deploy:aws:dev": "./scripts/deploy-aws.sh dev",
    "deploy:aws:preview": "./scripts/deploy-aws.sh preview",
    "deploy:aws:prod": "./scripts/deploy-aws.sh production",
    "deploy:aws:setup": "./scripts/setup-aws-infra.sh",
    "deploy:aws:setup:dev": "./scripts/setup-aws-infra.sh dev",
    "deploy:aws:setup:preview": "./scripts/setup-aws-infra.sh preview",
    "deploy:aws:setup:prod": "./scripts/setup-aws-infra.sh production",
    "deploy:verify": "./scripts/verify-prod-deployment.sh",
    "secrets:add": "./scripts/add-github-secrets.sh",
    "watch": "turbo watch",
    "format": "turbo format",
    "format:fix": "turbo format:fix",
    "postinstall": "pnpm check-deps",
    "build": "pnpm locales:validate && turbo build",
    "check": "pnpm locales:validate && turbo check",
    "locales:validate": "ts-node packages/core/locales/scripts/validate-translations.ts",
    "locales:coverage": "ts-node packages/core/locales/scripts/translation-coverage.ts",
    "check-deps": "check-dependency-version-consistency .",
    "check-circular-deps": "turbo check-circular-deps",
    "tamagui:check": "tamagui check",
    "tamagui:upgrade": "pnpm up '*tamagui*'@latest '@tamagui/*'@latest",
    "tamagui:upgrade:canary": "pnpm up '*tamagui*'@canary '@tamagui/*'@canary",
    "supa": "pnpm env-local pnpx supabase --workdir packages",
    "supa:functions": "pnpm supa functions serve --env-file ./packages/supabase/.env",
    "supa:prod": "pnpm env-prod pnpx supabase --workdir packages",
    "supa:config:push": "node ./scripts/run-supabase-config.cjs local config push",
    "supa:config:push:preview": "node ./scripts/run-supabase-config.cjs preview config push",
    "supa:config:push:prod": "node ./scripts/run-supabase-config.cjs production config push",
    "supa:seed": "pnpm env-local pnpm --filter @app/supabase seed",
    "supa:seed:prod": "pnpm env-prod pnpm --filter @app/supabase seed",
    "supa:seed:onet": "pnpm env-local pnpm --filter @app/supabase seed:onet",
    "supa:seed:onet:prod": "pnpm env-prod pnpm --filter @app/supabase seed:onet",
    "supa:news:import": "pnpm env-local pnpm --filter @app/supabase seed:news-import",
    "supa:news:feeds": "pnpm env-local pnpm --filter @app/supabase seed:news-feeds",
    "supa:functions:prod": "pnpm supa:prod functions deploy trpc --project-ref qmfmpcyxsihhfttvqpbw",
    "supa:functions:preview": "pnpm supa:preview functions deploy trpc --project-ref rxcbcxkzielwojunbtph",
    "supa:preview": "pnpm env-preview pnpx supabase --workdir packages",
    "supa:db:push": "pnpm supa db push --linked",
    "supa:db:push:prod": "pnpm env-prod pnpx supabase --workdir packages db push --linked",
    "supa:db:push:preview": "pnpm env-preview pnpx supabase --workdir packages db push --linked",
    "supa:migration:up": "pnpm supa migration up",
    "supa:seed:preview": "pnpm env-preview pnpm --filter @app/supabase seed",
    "supa:reset": "pnpm supa db reset && pnpm supa seed && pnpm test",
    "supa:generate": "dotenv -e .env -- pnpx supabase --workdir packages gen types typescript --local > packages/supabase/types.ts",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint && pnpm lint:routes",
    "lint:fix": "turbo lint:fix && pnpm lint:routes",
    "lint:routes": "node ./scripts/check-hardcoded-routes.mjs",
    "generate": "turbo gen",
    "version:auto": "node ./scripts/update-app-version.mjs",
    "test:build": "pnpm build && echo '✅ All packages built successfully'",
    "test:lint": "pnpm lint:fix && pnpm typecheck && pnpm check-deps",
    "test:deps": "pnpm check-deps && pnpm check-circular-deps",
    "test:tamagui": "pnpm tamagui:check",
    "test:api": "pnpm --filter @app/supabase test:endpoints",
    "test:integration": "pnpm test:deps && pnpm test:lint && pnpm test:tamagui",
    "test:all": "pnpm test:integration && pnpm test:build",
    "test:unit": "turbo test:unit",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:vitest": "pnpm run test:unit",
    "test:vitest:watch": "pnpm run test:watch",
    "test:vitest:ui": "vitest --ui",
    "test:core": "pnpm --filter @app/core test",
    "test:schemas": "pnpm --filter @app/schemas test",
    "test:expo": "pnpm --filter expo-app test",
    "test:health": "ts-node scripts/test-health-analyzer.ts",
    "test:health:full": "pnpm test:unit && pnpm test:health",
    "test:orchestrated": "ts-node scripts/test-orchestrator.ts",
    "test": "pnpm test:unit && pnpm test:api",
    "test:contracts": "vitest run contracts/contract-suite.test.ts --config vitest.contracts.config.ts",
    "test:performance": "cd apps/expo && time pnpm web:build",
    "validate:migration": "pnpm test:all && echo '✅ Migration validation complete'",
    "test:playwright": "playwright test"
  },
  "packageManager": "pnpm@10.20.0",
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@playwright/test": "^1.56.1",
    "@tamagui/config": "catalog:",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.3.0",
    "@testing-library/react-native": "^13.3.3",
    "@testing-library/user-event": "^14.5.2",
    "@turbo/gen": "^2.5.8",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.10",
    "@vitest/ui": "^4.0.10",
    "check-dependency-version-consistency": "^5.0.1",
    "flow-remove-types": "^2.291.0",
    "fs-extra": "^11.2.0",
    "jsdom": "^27.2.0",
    "msw": "^2.4.2",
    "turbo": "^2.6.1",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.10",
    "vitest-mock-extended": "^3.1.0"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^5.4.0",
    "@stripe/stripe-js": "^8.5.2",
    "date-fns": "^4.1.0",
    "react-window": "^2.2.3"
  }
}
