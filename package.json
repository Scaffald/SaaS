{
  "name": "scaffald",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "affected:build": "nx affected -t build",
    "affected:lint": "nx affected -t lint",
    "affected:test": "nx affected -t test",
    "affected:typecheck": "nx affected -t typecheck",
    "android": "pnpm --filter scaffald-app android",
    "prebuild": "pnpm --filter scaffald-app prebuild && pnpm setup-sentry",
    "build": "pnpm locales:validate && nx run-many -t build",
    "build:forsured": "pnpm --filter @unicornlove/forsured-app build",
    "check": "pnpm locales:validate && nx run-many -t lint && nx run-many -t typecheck --parallel=1",
    "check:affected": "pnpm locales:validate && nx affected -t lint && nx affected -t typecheck --parallel=1",
    "check:affected:fast": "nx affected -t lint && nx affected -t typecheck",
    "check-circular-deps": "nx graph --file=output.html",
    "check-deps": "check-dependency-version-consistency .",
    "deploy": "pnpm prod",
    "deploy:aws": "./scripts/deploy-aws.sh",
    "deploy:aws:dev": "./scripts/deploy-aws.sh dev",
    "deploy:aws:preview": "./scripts/deploy-aws.sh preview",
    "deploy:aws:prod": "./scripts/deploy-aws.sh production",
    "deploy:aws:setup": "./scripts/setup-aws-infra.sh",
    "deploy:aws:setup:dev": "./scripts/setup-aws-infra.sh dev",
    "deploy:aws:setup:preview": "./scripts/setup-aws-infra.sh preview",
    "deploy:aws:setup:prod": "./scripts/setup-aws-infra.sh production",
    "deploy:reset": "./scripts/deploy-reset.sh",
    "deploy:verify": "./scripts/verify-prod-deployment.sh",
    "dev": "(pnpm watchman:reset || true) && (pnpm --filter @unicornlove/ui watch &) && pnpm --filter scaffald-app start",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm dev:forsured\"",
    "dev:forsured": "bash scripts/dev-forsured.sh",
    "env-local": "cross-env NODE_ENV=development APP_ENV=development dotenv -e .env --",
    "env-preview": "cross-env NODE_ENV=production APP_ENV=preview dotenv -e .env.preview --",
    "env-prod": "cross-env NODE_ENV=production APP_ENV=production dotenv -e .env.production --",
    "env-test": "cross-env NODE_ENV=test APP_ENV=test dotenv -e .env.test --",
    "format": "nx format:check",
    "format:fix": "nx format:write",
    "generate": "nx generate",
    "graph": "nx graph",
    "preinstall": "sh scripts/setup-supabase-bin.sh || true",
    "postinstall": "sh scripts/setup-supabase-bin.sh && node scripts/fix-tailwindcss-sucrase.mjs && pnpm check-deps 2>&1 || echo '⚠️  Dependency version check completed (warnings expected for published @unicornlove/ui package)'",
    "ios": "pnpm --filter scaffald-app ios",
    "lint": "nx run-many -t lint && pnpm lint:routes && pnpm lint:sorted-keys",
    "lint:affected": "nx affected -t lint && pnpm lint:routes && pnpm lint:sorted-keys",
    "lint:fix": "pnpm lint:sort-package-json && nx run-many -t lint:fix && pnpm lint:routes",
    "lint:routes": "node ./scripts/check-hardcoded-routes.mjs",
    "lint:sort-package-json": "sort-package-json '**/package.json' --ignore '**/node_modules/**'",
    "lint:sort-package-json:check": "sort-package-json '**/package.json' --ignore '**/node_modules/**' --check",
    "lint:sorted-keys": "node ./scripts/check-sorted-keys.mjs",
    "lint:verbose": "nx run-many -t lint --verbose && pnpm lint:routes",
    "locales:coverage": "ts-node packages/scf-core/locales/scripts/translation-coverage.ts",
    "locales:validate": "ts-node packages/scf-core/locales/scripts/validate-translations.ts",
    "nx:reset": "nx reset",
    "prebuild:clean": "pnpm --filter scaffald-app prebuild --clean && pnpm setup-sentry",
    "prebuild:only": "pnpm --filter scaffald-app prebuild",
    "preview": "./scripts/deploy.sh preview",
    "prod": "./scripts/deploy.sh production",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run",
    "reset": "rm -rf node_modules apps/*/node_modules packages/*/node_modules .nx apps/scaffald/.expo apps/scaffald/dist apps/scaffald/android/build apps/scaffald/ios/build apps/scaffald/.next **/tsconfig.tsbuildinfo **/.DS_Store && pnpm store prune && echo '✅ Cache cleared! Run pnpm install to reinstall dependencies.'",
    "reset:full": "pnpm reset && rm -rf apps/scaffald/android apps/scaffald/ios && echo '✅ Full reset complete! Run pnpm prebuild to regenerate native directories.'",
    "secrets:add": "./scripts/add-github-secrets.sh",
    "setup-sentry": "node scripts/setup-sentry.mjs",
    "storybook": "pnpm --filter @unicornlove/beyond-ui storybook",
    "storybook:build": "pnpm --filter @unicornlove/beyond-ui build-storybook",
    "storybook:deploy": "./scripts/deploy-storybook-aws.sh",
    "storybook:deploy:dev": "./scripts/deploy-storybook-aws.sh dev",
    "storybook:deploy:prod": "./scripts/deploy-storybook-aws.sh prod",
    "supa": "pnpm env-local pnpx supabase --workdir packages",
    "supa:config:push": "pnpm env-local pnpx supabase --workdir packages config push",
    "supa:config:push:preview": "pnpm env-preview pnpx supabase --workdir packages config push",
    "supa:config:push:prod": "pnpm env-prod pnpx supabase --workdir packages config push",
    "supa:db:push": "pnpm supa db push --linked",
    "supa:db:push:preview": "pnpm env-preview pnpx supabase --workdir packages db push --linked",
    "supa:db:push:prod": "pnpm env-prod pnpx supabase --workdir packages db push --linked",
    "supa:functions": "pnpm supa functions serve --env-file ./.env",
    "supa:functions:preview": "pnpm supa:preview functions deploy trpc --project-ref rxcbcxkzielwojunbtph",
    "supa:functions:prod": "pnpm supa:prod functions deploy trpc --project-ref qmfmpcyxsihhfttvqpbw",
    "supa:generate": "dotenv -e .env -- pnpx supabase --workdir packages gen types typescript --local > packages/supabase/types.ts",
    "supa:migration:up": "pnpm supa migration up",
    "supa:news:feeds": "pnpm env-local pnpm --filter @scf/supabase seed:news-feeds",
    "supa:news:import": "pnpm env-local pnpm --filter @scf/supabase seed:news-import",
    "supa:preview": "pnpm env-preview pnpx supabase --workdir packages",
    "supa:prod": "pnpm env-prod pnpx supabase --workdir packages",
    "supa:reset": "pnpm supa db reset && pnpm supa seed && pnpm test",
    "supa:reset:forsured": "pnpm supa db reset && pnpm supa:seed:forsured",
    "supa:restart": "pnpm supa stop && pnpm supa start",
    "supa:seed": "pnpm env-local pnpm --filter @scf/supabase seed",
    "supa:seed:forsured": "pnpm env-local pnpm --filter @scf/supabase seed:forsured",
    "supa:seed:onet": "pnpm env-local pnpm --filter @scf/supabase seed:onet",
    "supa:seed:onet:prod": "pnpm env-prod pnpm --filter @scf/supabase seed:onet",
    "supa:seed:preview": "pnpm env-preview pnpm --filter @scf/supabase seed",
    "supa:seed:prod": "pnpm env-prod pnpm --filter @scf/supabase seed",
    "test": "pnpm test:unit && pnpm test:api",
    "test:all": "pnpm test:integration && pnpm test:build",
    "test:api": "pnpm --filter @scf/supabase test:endpoints",
    "test:build": "pnpm build && echo '✅ All packages built successfully'",
    "test:contracts": "vitest run tests/reports/contracts/contract-suite.test.ts --config vitest.contracts.config.ts",
    "test:core": "pnpm --filter @scf/core test",
    "test:coverage": "vitest run --coverage",
    "test:deno": "deno test --allow-all --config packages/supabase/tests/deno.json packages/supabase/tests",
    "test:deno:types": "cd packages/supabase/functions && find . -name '*.ts' -not -name '*.test.ts' -not -path './__tests__/*' -not -path './*/__tests__/*' -not -path './node_modules/*' -type f | xargs deno check",
    "test:deps": "pnpm check-deps && pnpm check-circular-deps",
    "test:expo": "pnpm --filter scaffald-app test",
    "test:forsured": "pnpm --filter @unicornlove/forsured-app test",
    "test:forsured:all": "pnpm --filter @unicornlove/forsured-app test:all",
    "test:forsured:e2e": "pnpm --filter @unicornlove/forsured-app test:e2e",
    "test:forsured:e2e:admin": "pnpm --filter @unicornlove/forsured-app test:e2e:admin",
    "test:forsured:e2e:auth": "pnpm --filter @unicornlove/forsured-app test:e2e:auth",
    "test:forsured:e2e:broker": "pnpm --filter @unicornlove/forsured-app test:e2e:broker",
    "test:forsured:e2e:ccpa": "pnpm --filter @unicornlove/forsured-app test:e2e:ccpa",
    "test:forsured:e2e:contractor": "pnpm --filter @unicornlove/forsured-app test:e2e:contractor",
    "test:forsured:e2e:features": "pnpm --filter @unicornlove/forsured-app test:e2e:features",
    "test:forsured:e2e:manager": "pnpm --filter @unicornlove/forsured-app test:e2e:manager",
    "test:forsured:e2e:ui": "pnpm --filter @unicornlove/forsured-app test:e2e:ui",
    "test:forsured:integration": "pnpm --filter @unicornlove/forsured-app test:integration",
    "test:forsured:unit": "pnpm --filter @unicornlove/forsured-app test:unit",
    "test:forsured:watch": "pnpm --filter @unicornlove/forsured-app test:watch",
    "test:health": "ts-node scripts/test-health-analyzer.ts",
    "test:health:full": "pnpm test:unit && pnpm test:health",
    "test:integration": "pnpm test:deps && pnpm test:lint",
    "test:lint": "pnpm lint:fix && pnpm typecheck && pnpm check-deps",
    "test:orchestrated": "ts-node scripts/test-orchestrator.ts",
    "test:performance": "cd apps/scaffald && time pnpm web:build",
    "test:playwright": "playwright test",
    "test:profile": "vitest run --reporter=verbose --outputFile=tests/reports/coverage/test-results.json",
    "test:profile:slow": "vitest run --reporter=verbose | grep -E '(✓|✗|↓).*[0-9]+ms' | sort -t'(' -k2 -rn | head -50",
    "test:scaffald": "pnpm --filter scaffald test:unit",
    "test:scaffald:coverage": "pnpm --filter scaffald test:coverage",
    "test:scaffald:e2e": "pnpm --filter scaffald test:e2e",
    "test:scaffald:e2e:ui": "pnpm --filter scaffald test:e2e:ui",
    "test:schemas": "pnpm --filter @scf/schemas test",
    "test:unit": "nx run-many -t test",
    "test:vitest": "pnpm run test:unit",
    "test:vitest:ui": "vitest --ui",
    "test:vitest:watch": "pnpm run test:watch",
    "test:watch": "vitest",
    "typecheck": "nx run-many -t typecheck --parallel=1",
    "typecheck:affected": "nx affected -t typecheck --parallel=1",
    "validate:migration": "pnpm test:all && echo '✅ Migration validation complete'",
    "version:auto": "node ./scripts/update-app-version.mjs",
    "watch": "nx run-many -t watch",
    "watchman:reset": "watchman watch-del \"$(pwd)\" ; watchman watch-project \"$(pwd)\"",
    "web": "pnpm --filter scaffald-app web",
    "web:build": "pnpm --filter scaffald-app web:build"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^5.6.0",
    "@stripe/stripe-js": "^8.7.0",
    "@tiptap/core": "^2.27.2",
    "date-fns": "^4.1.0",
    "html2canvas": "^1.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@nx/js": "^22.4.5",
    "@nx/vite": "^22.4.5",
    "@nx/vitest": "^22.4.5",
    "@nx/workspace": "^22.4.5",
    "@playwright/test": "^1.58.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.3",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/react-native": "^13.3.3",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "check-dependency-version-consistency": "^5.0.1",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^7.4.2",
    "flow-remove-types": "^2.299.0",
    "fs-extra": "^11.3.3",
    "jsdom": "^27.2.0",
    "msw": "^2.12.8",
    "nx": "^22.4.5",
    "semantic-release": "^25.0.3",
    "sort-package-json": "^3.6.1",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.18",
    "vitest-mock-extended": "^3.1.0"
  },
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "overrides": {
      "react-dom": "19.2.0"
    }
  }
}
