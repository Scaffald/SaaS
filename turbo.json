{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["tsconfig.tsbuildinfo"]
    },
    "test:unit": {
      "cache": true,
      "outputs": ["coverage/**"]
    },
    "watch": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": ["tsconfig.tsbuildinfo"]
    },
    "format": {
      "outputs": []
    },
    "format:fix": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "lint:fix": {
      "outputs": []
    },
    "check": {
      "dependsOn": ["format:fix", "lint:fix", "typecheck"],
      "outputs": []
    },
    "check#expo-app": {
      "dependsOn": ["format:fix", "lint:fix", "typecheck"],
      "outputs": []
    },
    "check-circular-deps": {
      "cache": false
    }
  }
}
