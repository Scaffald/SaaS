{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "scaffald-app", "start"],
      "port": 8081
    },
    {
      "name": "supabase",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["supa", "start"],
      "port": 54321
    },
    {
      "name": "edge-functions",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["supa:functions"],
      "port": 54321
    },
    {
      "name": "storybook",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@scaffald/ui", "storybook"],
      "port": 6006
    },
    {
      "name": "sdk-docs",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@scaffald/sdk", "docs:dev"],
      "port": 3000
    },
    {
      "name": "ui-watch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@scaffald/ui", "watch"],
      "port": 0
    }
  ]
}
