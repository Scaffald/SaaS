{
  "extends": "../../tsconfig.base",
  "include": [
    "app",
    "src",
    "types.d.ts",
    "../../types/custom-modules.d.ts",
    "../../packages/ui",
    "../../packages/api",
    "../../packages/core",
    "../../packages/schemas/src/**/*.ts",
    "../../packages/schemas/src/**/*.tsx",
    "../../packages/supabase/types.ts",
    "../../packages/supabase/client-types.ts",
    "../../packages/supabase/app-router-type.ts",
    "../../packages/supabase/helpers.ts",
    "../../packages/supabase/functions/_shared/schemas/**/*.ts",
    "../../packages/supabase/functions/_shared/phone.ts",
    "../../vitest.config.ts"
  ],
  "exclude": [
    "../../packages/supabase/functions/trpc/**/*",
    "../../packages/supabase/functions/job-import/**/*",
    "../../packages/supabase/functions/news/**/*",
    "../../packages/supabase/functions/_shared/notifications/**/*",
    "../../packages/supabase/functions/_shared/permissions/**/*",
    "../../packages/supabase/functions/_shared/utils/**/*",
    "../../packages/supabase/functions/_shared/mappers/**/*",
    "../../packages/supabase/functions/_shared/feedback-sync.ts",
    "../../packages/supabase/functions/_shared/team-audit-log.ts",
    "../../packages/supabase/functions/_shared/work-log-export.ts",
    "../../packages/supabase/scripts/**/*",
    "../../packages/supabase/types-trpc.ts"
  ],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "composite": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "baseUrl": "../../",
    "paths": {
      "@app/core": ["packages/core"],
      "@app/core/*": ["packages/core/*"],
      "@app/ui": ["packages/ui"],
      "@app/ui/*": ["packages/ui/src/*"],
      "@app/supabase": ["packages/supabase"],
      "@app/supabase/*": ["packages/supabase/*"],
      "@app/schemas": ["packages/schemas/src"],
      "@app/schemas/*": ["packages/schemas/src/*"],
      "@app/styleguide": ["packages/ui/src/styleguide/index.ts"],
      "@app/styleguide/*": ["packages/ui/src/styleguide/*"],
      "expo-clipboard": ["types/expo-clipboard.d.ts"]
    }
  },
  "references": []
}
