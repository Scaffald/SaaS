{
  "name": "@unicornlove/forsured-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run",
    "test:all": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:admin": "playwright test tests/e2e/admin-*.spec.ts",
    "test:e2e:auth": "playwright test tests/e2e/auth.spec.ts tests/e2e/login-*.spec.ts tests/e2e/onboarding.spec.ts tests/e2e/settings.spec.ts tests/e2e/direct-*.spec.ts tests/e2e/scaffald-*.spec.ts",
    "test:e2e:broker": "playwright test tests/e2e/broker-*.spec.ts --grep-invert='Manual|Audit'",
    "test:e2e:ccpa": "playwright test tests/e2e/ccpa-*.spec.ts tests/e2e/privacy-*.spec.ts",
    "test:e2e:contractor": "playwright test tests/e2e/contractor-*.spec.ts --grep-invert='Manual'",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:features": "playwright test tests/e2e/document-*.spec.ts tests/e2e/task-*.spec.ts tests/e2e/project-*.spec.ts tests/e2e/notifications-*.spec.ts tests/e2e/storage-*.spec.ts tests/e2e/user-set-*.spec.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:manager": "playwright test tests/e2e/manager-*.spec.ts tests/e2e/gc-*.spec.ts",
    "test:e2e:specs": "playwright test tests/e2e/specs/",
    "test:e2e:ui": "playwright test --ui",
    "test:integration": "vitest run tests/integration",
    "test:performance": "vitest run tests/performance",
    "test:smoke": "RUN_SMOKE_TESTS=true vitest run viteDevServer.smoke",
    "test:unit": "vitest run src",
    "test:validation": "vitest run dependencyChain.validation",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@scaffald/ui": "workspace:*",
    "@scf/supabase": "workspace:*",
    "@supabase/supabase-js": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@trpc/client": "catalog:",
    "@trpc/react-query": "catalog:",
    "@trpc/server": "catalog:",
    "@unicornlove/compliance": "workspace:*",
    "@unicornlove/forsured": "workspace:*",
    "@unicornlove/insurance": "workspace:*",
    "@unicornlove/tasks": "workspace:*",
    "lucide-react": "^0.344.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native-web": "catalog:",
    "react-router-dom": "^7.9.5",
    "sonner": "^1.7.0",
    "superjson": "catalog:",
    "uuid": "^13.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "catalog:",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "dotenv": "^16.6.1",
    "jsdom": "^24.0.0",
    "typescript": "catalog:",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
