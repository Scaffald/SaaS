{
  "compilerOptions": {
    "baseUrl": "../../",
    "composite": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "paths": {
      "@scf/core": ["packages/scf-core"],
      "@scf/core/*": ["packages/scf-core/*"],
      "@scf/schemas": ["packages/scf-schemas/src"],
      "@scf/schemas/*": ["packages/scf-schemas/src/*"],
      "@scf/supabase": ["packages/scf-supabase"],
      "@scf/supabase/*": ["packages/scf-supabase/*"],
      "@scf/trpc": ["packages/scf-trpc/src"],
      "@scf/trpc/*": ["packages/scf-trpc/src/*"],
      "@unicornlove/ui": ["packages/ui/src/index.tsx"],
      "@unicornlove/ui/*": ["packages/ui/src/*"],
      "expo-clipboard": ["types/expo-clipboard.d.ts"]
    },
    "skipDefaultLibCheck": true,
    "skipLibCheck": true
  },
  "exclude": [
    "../../packages/scf-supabase/functions/**/*",
    "../../packages/scf-supabase/scripts/**/*",
    "../../packages/scf-supabase/types-trpc.ts",
    "../../packages/ui/src/**/*.stories.ts",
    "../../packages/ui/src/**/*.stories.tsx"
  ],
  "extends": "../../tsconfig.base",
  "include": [
    "app",
    "src",
    "types.d.ts",
    "../../types/custom-modules.d.ts",
    "../../types/flow-remove-types.d.ts",
    "../../packages/api",
    "../../packages/scf-core",
    "../../packages/ui/src",
    "../../packages/scf-schemas/src/**/*.ts",
    "../../packages/scf-schemas/src/**/*.tsx",
    "../../packages/scf-trpc/src/**/*.ts",
    "../../packages/scf-supabase/types.ts",
    "../../packages/scf-supabase/client-types.ts",
    "../../packages/scf-supabase/app-router-type.ts",
    "../../packages/scf-supabase/app-router-type-only.ts",
    "../../packages/scf-supabase/helpers.ts",
    "../../vitest.config.ts",
    "../../tests/infrastructure/vitest/helpers/database.ts",
    "../../tests/infrastructure/vitest/plugins/flow-remove.ts"
  ],
  "references": []
}
