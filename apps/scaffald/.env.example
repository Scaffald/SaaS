# Mapbox Configuration
# Get your tokens from: https://account.mapbox.com/access-tokens/

# Secret token for downloading Mapbox SDK binaries (required for iOS builds)
# IMPORTANT: This must be a SECRET token (starts with sk.), not a public token
# Create a secret token with "Downloads:Read" scope
MAPBOX_DOWNLOADS_TOKEN=sk.your_secret_token_here

# Public access token for runtime API calls (safe to expose to clients)
# This is used for map rendering and geocoding APIs
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your_public_token_here
