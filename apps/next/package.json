{
  "name": "next-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@4.1.1",
  "scripts": {
    "dev": "yarn with-env next dev",
    "build": "cd ../.. && yarn build && cd apps/next && yarn next:build",
    "next:build": "yarn with-env next build",
    "start": "yarn with-env next start",
    "serve": "NODE_ENV=production yarn with-env next start --port 8151",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "with-env": "dotenv -e ../../.env -c --",
    "check:type": "tsc --outDir /tmp",
    "check:type:watch": "yarn check:type -w"
  },
  "dependencies": {
    "@app/ui": "*",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/auth-helpers-react": "^0.5.0",
    "@supabase/supabase-js": "^2.48.1",
    "@tamagui/next-theme": "^1.133.1",
    "@tamagui/react-native-svg": "^1.133.1",
    "@tanstack/react-query": "^5.90.1",
    "@trpc/server": "^11.5.1",
    "app": "*",
    "next": "^15.5.3",
    "raf": "^3.4.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.2",
    "vercel": "latest",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/preset-flow": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@next/bundle-analyzer": "15.4.1",
    "@tamagui/next-plugin": "^1.133.1",
    "@types/node": "^24.5.2",
    "dotenv-cli": "^8.0.0"
  }
}
