{
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": ".",
    "paths": {
      "@app/core": ["app/core/index"],
      "@app/core/*": ["app/core/*"],
      "@app/ui": ["packages/ui"],
      "@app/ui/*": ["packages/ui/*"],
      "@app/api": ["packages/api"],
      "@app/api/*": ["packages/api/*"],
      "@app/jobs": ["packages/jobs/src"],
      "@app/jobs/*": ["packages/jobs/src/*"],
      "@app/supabase": ["supabase"],
      "@app/supabase/*": ["supabase/*"]
    },
    "importHelpers": true,
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "downlevelIteration": true,
    "esModuleInterop": true,
    "preserveSymlinks": true,
    "incremental": true,
    "module": "ESNext",
    "moduleResolution": "node",
    "moduleSuffixes": [".web", ".native", ".ios", ".android", ""],
    "forceConsistentCasingInFileNames": true,
    "noEmitOnError": false,
    "noImplicitAny": false,
    "noImplicitReturns": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "experimentalDecorators": true,
    "useUnknownInCatchVariables": false,
    "preserveConstEnums": true,
    // DONT DO THIS so jsdoc will remain
    "removeComments": false,
    "strict": true,
    "skipLibCheck": true,
    "typeRoots": ["node_modules/@types", "environment.d.ts"],
    "sourceMap": false,
    "target": "ESNext",
    "types": ["node"],
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"],
    "resolveJsonModule": true,
    "plugins": [
      {
        // docs: https://github.com/nderscore/tamagui-typescript-plugin#readme
        "name": "@nderscore/tamagui-typescript-plugin",
        "pathToApp": "apps/next"
      }
    ]
  },
  "exclude": ["_"],
  "typeAcquisition": {
    "enable": true
  }
}
