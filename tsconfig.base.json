{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "jsx": "preserve",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noImplicitOverride": true,
    "paths": {
      "@scf/core": ["./packages/scf-core"],
      "@scf/schemas": ["./packages/scf-schemas/src"],
      "@scf/schemas/*": ["./packages/scf-schemas/src/*"],
      "@scf/supabase": ["./packages/supabase"],
      "@scf/trpc": ["./packages/scf-trpc/src"],
      "@scf/trpc/*": ["./packages/scf-trpc/src/*"],
      "@test-helpers": ["./tests/infrastructure/vitest/helpers"],
      "@test-helpers/*": ["./tests/infrastructure/vitest/helpers/*"],
      "@unicornlove/ui": ["./packages/ui/src"],
      "@unicornlove/ui/*": ["./packages/ui/src/*"],
      "expo-clipboard": ["./types/expo-clipboard.d.ts"],
      "flow-remove-types": ["./types/flow-remove-types.d.ts"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022"
  },
  "exclude": ["node_modules", "**/node_modules/**", "**/.turbo/**"],
  "include": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx"]
}
