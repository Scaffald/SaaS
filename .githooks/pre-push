#!/bin/bash

# Pre-push hook: validates that affected builds + tests pass before pushing.
#
# Strategy: Heavy checks (build, test) run BEFORE the SSH connection opens
# via `pnpm prepush`, which writes a stamp file on success. This hook only
# verifies the stamp — fast enough to not timeout the SSH connection.
#
# Workflow:
#   1. Developer runs: git push (this hook fires)
#   2. If stamp exists for current HEAD → pass immediately
#   3. If no stamp → run checks inline, write stamp, then pass
#
# Skip with: git push --no-verify, SKIP_HOOKS=1, or SKIP_PREPUSH=1

set -e

# Quick-skip
if [ "${SKIP_HOOKS:-}" = "1" ] || [ "${SKIP_PREPUSH:-}" = "1" ]; then
  echo "⏭️  Pre-push hooks skipped (SKIP_HOOKS/SKIP_PREPUSH=1)"
  exit 0
fi

PROJECT_ROOT="$(git rev-parse --show-toplevel)"
cd "$PROJECT_ROOT"

HEAD_SHA=$(git rev-parse HEAD)
STAMP_FILE="$PROJECT_ROOT/.nx/cache/.prepush-validated"

# Fast path: stamp exists for this exact commit
if [ -f "$STAMP_FILE" ] && [ "$(cat "$STAMP_FILE")" = "$HEAD_SHA" ]; then
  echo "✅ Pre-push: already validated $(echo "$HEAD_SHA" | cut -c1-8)"
  exit 0
fi

# Slow path: run checks now (will hold SSH connection open)
echo "🔍 Running pre-push checks (no stamp found for $(echo "$HEAD_SHA" | cut -c1-8))..."
echo "   💡 Tip: run 'pnpm prepush' before pushing to avoid SSH timeouts"

# Memory cap
export NODE_OPTIONS="${NODE_OPTIONS:---max-old-space-size=4096}"

# Fetch to ensure nx affected has correct base
git fetch origin main 2>/dev/null || true

# Timeout support
TIMEOUT_CMD=""
for cmd in timeout gtimeout; do
  if command -v "$cmd" >/dev/null 2>&1; then
    TIMEOUT_CMD="$cmd"
    break
  fi
done

PREPUSH_TIMEOUT="${PREPUSH_TIMEOUT:-180}"

run_with_timeout() {
  if [ -n "$TIMEOUT_CMD" ]; then
    "$TIMEOUT_CMD" "${PREPUSH_TIMEOUT}s" "$@"
  else
    "$@"
  fi
}

# Run build + test in parallel
BUILD_LOG=$(mktemp)
TEST_LOG=$(mktemp)
cleanup() { rm -f "$BUILD_LOG" "$TEST_LOG"; }
trap cleanup EXIT

run_with_timeout pnpm affected:build > "$BUILD_LOG" 2>&1 &
BUILD_PID=$!

run_with_timeout pnpm affected:test > "$TEST_LOG" 2>&1 &
TEST_PID=$!

BUILD_EXIT=0
TEST_EXIT=0
wait $BUILD_PID || BUILD_EXIT=$?
wait $TEST_PID || TEST_EXIT=$?

# Timeout → allow push (CI catches issues)
if [ "$BUILD_EXIT" -eq 124 ] || [ "$TEST_EXIT" -eq 124 ]; then
  echo "⚠️ Pre-push timed out after ${PREPUSH_TIMEOUT}s — allowing push (CI will verify)"
  exit 0
fi

if [ "$BUILD_EXIT" -ne 0 ]; then
  echo "❌ Build failed:"
  cat "$BUILD_LOG"
  echo ""
  echo "Fix errors or push with: git push --no-verify"
  exit 1
fi

if [ "$TEST_EXIT" -ne 0 ]; then
  echo "❌ Tests failed:"
  cat "$TEST_LOG"
  echo ""
  echo "Fix failures or push with: git push --no-verify"
  exit 1
fi

# Write stamp
mkdir -p "$(dirname "$STAMP_FILE")"
echo "$HEAD_SHA" > "$STAMP_FILE"

echo "✅ Pre-push checks passed!"
exit 0
