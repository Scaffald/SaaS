#!/bin/bash

# Pre-commit hook: lint + typecheck for affected packages only
# Uses single nx invocation (lint,typecheck) to avoid graph lock / redundant work

set -e

# Quick-skip: SKIP_HOOKS=1 or SKIP_PRECOMMIT=1 to bypass (friendlier than --no-verify)
if [ "${SKIP_HOOKS:-}" = "1" ] || [ "${SKIP_PRECOMMIT:-}" = "1" ]; then
  echo "⏭️  Pre-commit hooks skipped (SKIP_HOOKS/SKIP_PRECOMMIT=1)"
  exit 0
fi

PROJECT_ROOT="$(git rev-parse --show-toplevel)"
cd "$PROJECT_ROOT"

# Allow more parallel NX tasks for lint (default 3 in nx.json is conservative)
export NX_PARALLEL=${NX_PARALLEL:-5}

echo "🔧 Running pre-commit checks (affected only)..."

# Portable timeout: use timeout/gtimeout if available (Linux, macOS with coreutils)
TIMEOUT_CMD=""
for cmd in timeout gtimeout; do
  if command -v "$cmd" >/dev/null 2>&1; then
    TIMEOUT_CMD="$cmd"
    break
  fi
done

PRECOMMIT_TIMEOUT="${PRECOMMIT_TIMEOUT:-90}"

run_precommit() {
  if [ -n "$TIMEOUT_CMD" ]; then
    "$TIMEOUT_CMD" "${PRECOMMIT_TIMEOUT}s" pnpm precommit 2>&1
  else
    pnpm precommit 2>&1
  fi
}

CHECK_OUTPUT=$(run_precommit) || CHECK_EXIT=$?
CHECK_EXIT=${CHECK_EXIT:-0}

# Detect timeout (124 = timeout exit code from GNU timeout)
if [ "${CHECK_EXIT:-0}" -eq 124 ]; then
  echo "⚠️ Pre-commit checks timed out after ${PRECOMMIT_TIMEOUT}s"
  echo "   Allowing commit - please run 'pnpm check:affected' manually to verify"
  echo "✅ Pre-commit checks passed (with warning)!"
  exit 0
fi

# Strategy: only fail if errors are in files we actually staged.
# Pre-existing errors in other files should not block commits.
if [ "${CHECK_EXIT:-0}" -ne 0 ]; then
  # Get list of staged files (full relative paths for precise matching)
  STAGED_PATHS=$(git diff --cached --name-only 2>/dev/null)

  # Submodule pointer bumps need special handling (#470). A gitlink stages a
  # single directory path -- "packages/ui" -- and that path is a prefix of every
  # file inside the submodule, so the substring match below claims all of the
  # submodule's pre-existing violations as "errors in staged files". The
  # violation count is identical either side of the bump, which is the proof the
  # pointer move introduces none of them; yet the commit is blocked, so every
  # pointer bump has had to use --no-verify and skip the checks that would have
  # been useful.
  #
  # Replace each staged gitlink with the files that actually changed inside the
  # submodule between the old and new pointer. A bump then still fails on
  # violations it genuinely introduces, and no longer fails on ones it inherits.
  # If the pointers cannot be diffed (submodule not fetched, or newly added),
  # drop the gitlink rather than guessing -- pre-push and CI still lint it.
  STAGED_GITLINKS=$(git diff --cached --raw 2>/dev/null \
    | awk -F'\t' '{ split($1, m, " "); if (m[1] == ":160000" || m[2] == "160000") print $2 }')

  if [ -n "$STAGED_GITLINKS" ]; then
    while IFS= read -r sm_path; do
      [ -z "$sm_path" ] && continue
      # Drop the bare gitlink path from the match list.
      STAGED_PATHS=$(printf '%s\n' "$STAGED_PATHS" | grep -Fxv "$sm_path" || true)

      sm_old=$(git diff --cached --raw -- "$sm_path" 2>/dev/null | awk '{print $3}')
      sm_new=$(git diff --cached --raw -- "$sm_path" 2>/dev/null | awk '{print $4}')
      case "$sm_old" in *[!0]*) ;; *) continue ;; esac   # all-zero = newly added
      case "$sm_new" in *[!0]*) ;; *) continue ;; esac   # all-zero = removed

      sm_changed=$(git -C "$sm_path" diff --name-only "$sm_old" "$sm_new" 2>/dev/null) || continue
      [ -z "$sm_changed" ] && continue
      STAGED_PATHS=$(printf '%s\n%s' "$STAGED_PATHS" \
        "$(printf '%s\n' "$sm_changed" | sed "s|^|$sm_path/|")")
    done <<< "$STAGED_GITLINKS"
  fi

  # Known systemic TS errors to always ignore (pre-existing @types/react conflicts, SDK resolution)
  KNOWN_ERRORS="error TS2322|error TS4023|error TS2307|error TS2305|error TS7006|error TS2339|error TS18046|error TS2345|error TS2352|error TS2614"

  # Extract error lines that reference staged files, excluding known systemic errors
  # Uses path-segment matching to avoid false positives (e.g. Sidebar.tsx matching InquiryHelpSidebar.tsx)
  STAGED_ERRORS=""
  while IFS= read -r staged_path; do
    [ -z "$staged_path" ] && continue
    # Try matching by the last two path segments (dir/file) for precision
    staged_dir_file=$(echo "$staged_path" | rev | cut -d'/' -f1-2 | rev)
    MATCH=$(echo "$CHECK_OUTPUT" | grep -E "error TS|lint/" | grep -F "$staged_dir_file" | grep -vE "$KNOWN_ERRORS" || true)
    if [ -n "$MATCH" ]; then
      STAGED_ERRORS="${STAGED_ERRORS}${MATCH}\n"
    fi
  done <<< "$STAGED_PATHS"

  if [ -z "$STAGED_ERRORS" ]; then
    echo "⚠️ Pre-existing type errors detected (not in staged files)"
    echo "✅ Pre-commit checks passed!"
    exit 0
  fi
  echo "❌ Pre-commit checks failed. Errors in staged files:"
  echo -e "$STAGED_ERRORS"
  exit 1
fi

# Notify if staged files changed after lint/check (e.g. lint:fix modified files)
if ! git diff --quiet --staged 2>/dev/null; then
  echo "ℹ️ Some staged files changed. Review and re-stage:"
  git diff --name-only --staged
  echo ""
  echo "💡 Run 'git add <file>' to include updates."
fi

echo "✅ Pre-commit checks passed!"
exit 0
