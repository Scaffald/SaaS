# Test Environment Variables Template
# Copy this file to .env.test and fill in your actual values
# .env.test is gitignored and should never be committed

# ============================================
# Supabase Configuration
# ============================================
# Local Supabase instance (default when running `pnpm supa start`)
# REST API (profiles, jobs, etc.) requires pnpm supa:functions in a second terminal.
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: explicit REST API base for local dev (Forsured/Scaffald SDK)
# VITE_SCAFFALD_API_URL=http://127.0.0.1:54321/functions/v1/api

# Optional: raise Edge Functions file watcher limit if you see "too many files" warnings (default: 4000)
# SUPABASE_FUNCTIONS_WATCH_LIMIT=4000

# Alternative: Use NEXT_PUBLIC_ prefix for server-side tests
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# GoTrue Configuration (Magic Links)
# ============================================
# Base URL for magic link redirects
# Priority: GOTRUE_SITE_URL > APP_URL > default (http://localhost:5173)
GOTRUE_SITE_URL=http://localhost:5173
# Alternative to GOTRUE_SITE_URL:
# APP_URL=http://localhost:5173

# Optional: Explicit allow list of redirect URLs
# Auto-generated from GOTRUE_SITE_URL if not set
GOTRUE_URI_ALLOW_LIST=http://localhost:5173,http://localhost:5173/auth/callback,http://127.0.0.1:5173,http://127.0.0.1:5173/auth/callback,http://127.0.0.1:8081

# ============================================
# Encryption
# ============================================
VITE_ENCRYPTION_KEY_ID=your-encryption-key-id-here

# ============================================
# Mailpit Configuration (Optional)
# ============================================
# Mailpit URL for email testing (default: http://127.0.0.1:54324)
MAILPIT_URL=http://127.0.0.1:54324

# ============================================
# CORS Configuration (Optional)
# ============================================
CORS_ORIGIN=http://localhost:3000

# ============================================
# Notes
# ============================================
# - Get Supabase keys from: pnpm supa status (after starting Supabase)
# - REST API (no 404s): run pnpm supa:functions in a second terminal; verify with curl -s http://127.0.0.1:54321/functions/v1/api/health
# - Default anon key for local Supabase: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# - Default service role key for local Supabase: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
# - See docs/gotrue-env-config.md for more details on GoTrue configuration
