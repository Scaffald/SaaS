{
  "$schema": "https://raw.githubusercontent.com/nrwl/nx/master/packages/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/**/*.test.tsx",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/*.spec.tsx",
      "!{projectRoot}/**/__tests__/**/*",
      "!{projectRoot}/**/__mocks__/**/*",
      "!{projectRoot}/vitest.config.ts"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/.env*",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/biome.json"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist", "{projectRoot}/tsconfig.tsbuildinfo"],
      "cache": true
    },
    "test": {
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/vitest.config.ts",
        "{workspaceRoot}/tests/infrastructure/**/*"
      ],
      "outputs": ["{workspaceRoot}/tests/reports/coverage/{projectName}"],
      "cache": true
    },
    "lint": {
      "inputs": ["default", "{workspaceRoot}/biome.json"],
      "outputs": [],
      "cache": true
    },
    "typecheck": {
      "inputs": ["default", "{workspaceRoot}/tsconfig.base.json"],
      "outputs": ["{projectRoot}/tsconfig.tsbuildinfo"],
      "cache": true
    },
    "format": {
      "inputs": ["default", "{workspaceRoot}/biome.json"],
      "outputs": [],
      "cache": true
    }
  },
  "defaultBase": "main",
  "plugins": [
    {
      "plugin": "@nx/vite/plugin",
      "options": {
        "testTargetName": "test",
        "buildTargetName": "build"
      },
      "exclude": ["apps/skills-map/**", "apps/trade-compass/**"]
    }
  ],
  "nxCloudAccessToken": "",
  "parallel": 3,
  "cacheDirectory": ".nx/cache",
  "useDaemonProcess": true
}
