    "hexColor": "'#rgb' and \"#rrggbb\" — use colors.*[theme] tokens",
    "accentRamp": "colors.blue[n] / purple / indigo / violet / pink — use semantic tokens (text.emphasis, fg.active, bg.emphasis); these ramps are not in the palette (#1028)"
